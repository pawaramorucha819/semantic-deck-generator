        {
          "id": "evidence-302",
          "type": "text",
          "statement": "受発注システムと在庫台帳を自動照合し、差異のある品目だけを通知する",
          "data": { "label": "在庫照合" }
        },
        {
          "id": "evidence-303",
          "type": "text",
          "statement": "品目ごとの発注点を自動判定し、補充が必要な品目を抽出する",
