{
  "name": "semantic-deck-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "意味構造 (presentation.json) から決定論的に PowerPoint を生成する Semantic Deck Generator V2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "tsx src/cli/generate.ts",
    "example": "tsx src/cli/generate.ts examples/inventory-system.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
