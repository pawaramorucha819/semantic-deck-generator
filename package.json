{
  "name": "semantic-deck-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "意味構造 (presentation.json) から決定論的に PowerPoint を生成する Semantic Deck Generator V2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node --import tsx src/cli/generate.ts",
    "sdg": "node --import tsx src/cli/main.ts",
    "example": "node --import tsx src/cli/generate.ts examples/inventory-system.json",
    "example:enterprise": "node --import tsx src/cli/main.ts generate examples/enterprise/presentation.json --config examples/enterprise/generation.config.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "example:relationships": "node --import tsx src/cli/main.ts generate examples/relationships/six-relationships.json --no-title-slide --report --strict --theme portable",
    "example:research": "node --import tsx src/cli/main.ts generate examples/research/nec-disaster-vlm-2026-10-14.json --no-title-slide --report --strict --theme portable",
    "example:decomposition": "node scripts/example-decomposition.mjs",
    "preview": "node scripts/preview-pptx.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "example:explanatory": "node --import tsx src/cli/main.ts generate examples/research/nec-explained-2026-10-15.json --no-title-slide --ai-mode off --report --strict --theme portable",
    "example:partition": "node --import tsx src/cli/main.ts generate examples/arguments/nec-candidate-quality-2026-10-16.json --argument-review examples/arguments/nec-assistant-review.json --no-title-slide --ai-mode off --report --strict --theme portable --out-dir examples/arguments/generated"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pptxgenjs": "3.12.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vitest@4.1.11": {
      "vite": "6.4.3"
    },
    "pptxgenjs@3.12.0": {
      "image-size": "2.0.4"
    }
  }
}
